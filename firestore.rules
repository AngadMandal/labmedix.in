rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS CONTROL (RBAC)
    // ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@labmedix.org' ||
        request.auth.token.email == 'superadmin@labmedix.org' ||
        request.auth.token.email.matches('.*superadmin.*') ||
        (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'super_admin')
      );
    }

    // ─────────────────────────────────────────────────────────────
    // AUDIT LOGS — Regulatory compliance immutable ledger
    // Append-only. Updates and deletions are permanently prohibited.
    // ─────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if true;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // FINANCIAL LEDGERS & VOUCHERS — Tamper-resistant records
    // Transactions and cash desk vouchers cannot be deleted.
    // ─────────────────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    match /vouchers/{voucherId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    match /ngoTransactions/{txnId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    match /charityGrants/{grantId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // USER ACCOUNTS — Strict Staff Authorization & Super Admin Protection
    // Root Super Admin account can never be deleted.
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && userId != 'usr_super_admin' && userId != 'usr_superadmin_root';
    }

    // ─────────────────────────────────────────────────────────────
    // PUBLIC QR CARD & IDENTITY VERIFICATION
    // Scannable by anyone using smartphone camera without login
    // ─────────────────────────────────────────────────────────────
    match /publicVerify/{code} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // PUBLIC CLINIC INFO, BRANDING, CATALOG & PACKAGES
    // Accessible on public homepage and patient self-service portal
    // ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /labTests/{testId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /healthPackages/{packageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /memberships/{membershipId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /membershipTiers/{tierId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // PATIENT PORTAL SELF-SERVICE SUBMISSIONS
    // Public patients can submit card applications, test bookings, orders
    // Staff have full management permissions once authenticated
    // ─────────────────────────────────────────────────────────────
    match /cardApplications/{appId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /labBookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    match /pharmacyOrders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // SYSTEM HEALTH, DIAGNOSTICS & BACKUPS
    // ─────────────────────────────────────────────────────────────
    match /_system_health/{docId} {
      allow read, write: if true;
    }

    match /_system_diagnostics/{docId} {
      allow read, write: if true;
    }

    match /_system_firestore_backups/{snapshotId} {
      allow read, write: if isAuthenticated();
    }

    match /_system_firestore_backups_meta/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // CLINICAL & OPERATIONAL COLLECTIONS (PROTECTED STAFF ONLY)
    // Patients, Cards, Wallets, EMR Encounters, Appointments, Doctors
    // ─────────────────────────────────────────────────────────────
    match /patients/{patientId} {
      allow read, write: if isAuthenticated();
    }

    match /cards/{cardId} {
      allow read, write: if isAuthenticated();
    }

    match /wallets/{walletId} {
      allow read, write: if isAuthenticated();
    }

    match /families/{familyId} {
      allow read, write: if isAuthenticated();
    }

    match /appointments/{appointmentId} {
      allow read, write: if isAuthenticated();
    }

    match /emrEncounters/{encounterId} {
      allow read, write: if isAuthenticated();
    }

    match /doctors/{doctorId} {
      allow read, write: if isAuthenticated();
    }

    match /doctorPayouts/{payoutId} {
      allow read, write: if isAuthenticated();
    }

    match /sampleDispatches/{dispatchId} {
      allow read, write: if isAuthenticated();
    }

    match /cardDispatches/{dispatchId} {
      allow read, write: if isAuthenticated();
    }

    match /cardDispatchBatches/{batchId} {
      allow read, write: if isAuthenticated();
    }

    match /patientVitals/{vitalsId} {
      allow read, write: if isAuthenticated();
    }

    match /ngoPartners/{partnerId} {
      allow read, write: if isAuthenticated();
    }

    match /healthCamps/{campId} {
      allow read, write: if isAuthenticated();
    }

    match /campAttendees/{attendeeId} {
      allow read, write: if isAuthenticated();
    }

    match /recoveryVault/{vaultId} {
      allow read, write: if isAuthenticated();
    }

    match /snapshots/{snapshotId} {
      allow read, write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────
    // SECURE CATCH-ALL FOR ANY OTHER APPLICATION COLLECTIONS
    // Requires authenticated session to prevent unauthorized exposure
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
