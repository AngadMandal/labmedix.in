rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // AUDIT LOGS — Append-only for regulatory & legal compliance (immutable)
    // Logs cannot be edited or deleted once written.
    // ─────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // FINANCIAL LEDGERS & VOUCHERS — Tamper-resistant records
    // Transactions and cash vouchers cannot be deleted.
    // ─────────────────────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /vouchers/{voucherId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /ngoTransactions/{txnId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /charityGrants/{grantId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // USER ACCOUNTS — Protect root Super Admin from deletion
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if userId != 'usr_super_admin';
    }

    // ─────────────────────────────────────────────────────────────
    // SYSTEM HEALTH & DIAGNOSTIC HEARTBEAT
    // Heartbeat pings and diagnostics for live connection monitoring
    // ─────────────────────────────────────────────────────────────
    match /_system_health/{docId} {
      allow read, write: if true;
    }

    match /_system_diagnostics/{docId} {
      allow read, write: if true;
    }

    match /_system_firestore_backups/{snapshotId} {
      allow read, write: if true;
    }

    match /_system_firestore_backups_meta/{docId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // PUBLIC QR CARD VERIFICATION
    // Unauthenticated QR scan verification
    // ─────────────────────────────────────────────────────────────
    match /publicVerify/{code} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // ALL COLLECTIONS — Multi-device live cloud synchronization
    // Allows seamless cross-device sync for clinic operations
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
