rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─────────────────────────────────────────────────────────────
    // LABMEDIX ENTERPRISE MULTI-DEVICE CENTRAL FIRESTORE SYNC RULES
    // Allows instant real-time live synchronization across all authorized
    // clinics, branches, devices, workstations, and patient portals.
    // ─────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
