rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // LABMEDIX ENTERPRISE MULTI-DEVICE CLOUD FIRESTORE SECURITY RULES
    // Role-Based Access Control, Real-Time Sync & Company Isolation
    // ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'angadmandal3@gmail.com' ||
        request.auth.token.email == 'admin@labmedix.in' ||
        request.auth.token.email == 'admin@labmedix.org' ||
        request.auth.token.admin == true
      );
    }

    // ── USER ACCOUNTS & STAFF DIRECTORY ──────────────────────────
    // Non-super-admins cannot elevate their own role, permissions, companyId, or status
    match /users/{userId} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isAuthenticated() && (request.auth.uid == userId || request.resource.data.uid == request.auth.uid || request.resource.data.email == request.auth.token.email));
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'customPermissions', 'allowedModules', 'staffId', 'companyId', 'status'
          ])
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ── HEALTH CARD APPLICATIONS & STAFF REQUESTS ────────────────
    // Self-approval prevented: Submitter cannot approve their own application unless Super Admin
    match /cardApplications/{applicationId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (
        // Submitter cannot approve own request
        !(request.resource.data.status == 'approved' && resource.data.submittedByStaffId == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }

    // ── HEALTH CARDS MASTER STORE ────────────────────────────────
    match /cards/{cardId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ── PATIENT CLINICAL DIRECTORY & VITALS ──────────────────────
    match /patients/{patientId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /patientVitals/{patientId} {
      allow read, write: if true;
    }

    // ── DIGITAL HEALTH WALLET & LEDGER ───────────────────────────
    match /wallets/{walletId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /wallet_transactions/{txnId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ── BILLING & PATIENT INVOICES ───────────────────────────────
    match /bills/{billId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ── STAFF HEALTH CARD TRANSACTIONS ───────────────────────────
    match /card_transactions/{txnId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ── CASH DESK VOUCHERS ───────────────────────────────────────
    match /cash_desk_vouchers/{voucherId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /vouchers/{voucherId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // ── CLINICAL EMR, QUEUES & APPOINTMENTS ──────────────────────
    match /emr/{docId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /emrEncounters/{docId} {
      allow read, create, update: if true;
      allow delete: if isSuperAdmin();
    }

    match /appointments/{appId} {
      allow read, write: if true;
    }

    match /doctor_queues/{queueId} {
      allow read, write: if true;
    }

    match /doctor_clinical_records/{recId} {
      allow read, write: if true;
    }

    // ── PUBLIC PORTAL BOOKINGS & ORDERS ──────────────────────────
    match /portalBookings/{bookingId} {
      allow read, write: if true;
    }

    match /labBookings/{bookingId} {
      allow read, write: if true;
    }

    match /laboratory_orders/{orderId} {
      allow read, write: if true;
    }

    match /specimens/{specimenId} {
      allow read, write: if true;
    }

    // Protected diagnostic reports: Locked reports cannot be altered without formal amendment
    match /diagnosticReports/{reportId} {
      allow read, create: if true;
      allow update: if isSuperAdmin() || (
        !resource.data.isLocked || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amendmentHistory', 'updatedAt']))
      );
      allow delete: if isSuperAdmin();
    }

    match /medicineOrders/{orderId} {
      allow read, write: if true;
    }

    match /pharmacyOrders/{orderId} {
      allow read, write: if true;
    }

    match /contactInquiries/{inquiryId} {
      allow read, write: if true;
    }

    // ── MASTER CATALOGS & CONFIGURATIONS ─────────────────────────
    match /memberships/{membershipId} {
      allow read, write: if true;
    }

    match /membershipTiers/{tierId} {
      allow read, write: if true;
    }

    match /families/{familyId} {
      allow read, write: if true;
    }

    match /doctors/{doctorId} {
      allow read, write: if true;
    }

    match /doctor_master/{doctorId} {
      allow read, write: if true;
    }

    match /labTests/{testId} {
      allow read, write: if true;
    }

    match /test_master/{testId} {
      allow read, write: if true;
    }

    match /healthPackages/{packageId} {
      allow read, write: if true;
    }

    // ── NGO & COMMUNITY WELFARE ──────────────────────────────────
    match /ngo_welfare/{ngoId} {
      allow read, write: if true;
    }

    match /ngoPartners/{ngoId} {
      allow read, write: if true;
    }

    match /healthCamps/{campId} {
      allow read, write: if true;
    }

    match /campAttendees/{attendeeId} {
      allow read, write: if true;
    }

    match /charityGrants/{grantId} {
      allow read, write: if true;
    }

    match /ngoTransactions/{txnId} {
      allow read, write: if true;
    }

    // ── CARD PRINTING & SAMPLE DISPATCHES ────────────────────────
    match /sampleDispatches/{dispatchId} {
      allow read, write: if true;
    }

    match /cardDispatches/{dispatchId} {
      allow read, write: if true;
    }

    match /cardDispatchBatches/{batchId} {
      allow read, write: if true;
    }

    match /recoveryVault/{vaultId} {
      allow read, write: if true;
    }

    match /snapshots/{snapshotId} {
      allow read, write: if true;
    }

    // ── SETTINGS & COMPANY PROFILE ───────────────────────────────
    // Company profile and enterprise settings only editable by Super Admin
    match /companyProfile/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── MULTI-DEVICE PRESENCE & TELEMETRY ────────────────────────
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    match /_system_active_devices/{docId} {
      allow read, write: if true;
    }

    match /_system_sync_events/{docId} {
      allow read, write: if true;
    }

    match /_system_cloud_backups/{docId} {
      allow read, write: if true;
    }

    match /_system_health/{docId} {
      allow read, write: if true;
    }

    match /_system_diagnostics/{diagId} {
      allow read, write: if true;
    }

    // ── SECURITY & AUDIT TRAIL ───────────────────────────────────
    // Audit logs are append-only. Modification is strictly disallowed.
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}
